<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_form_user_subscription" model="ir.ui.view">
        <field name="name">mail.template.form.user.subscription</field>
        <field name="model">mail.template</field>
        <field name="inherit_id" ref="mail.email_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='subject']" position="after">
                <label for="is_user_subscribable" string="User Subscription Possible"/>
                <field name="is_user_subscribable" nolabel="1"/>
            </xpath>
            <xpath expr="//form/sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_unsubscribed_users"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users">
                        <field name="unsubscribed_user_count"
                               widget="statinfo"
                               string="Unsubscribed"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="mail_template_list_user_subscription" model="ir.ui.view">
        <field name="name">mail.template.list.user.subscription</field>
        <field name="model">mail.template</field>
        <field name="inherit_id" ref="mail.email_template_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_user_subscribable"/>
            </xpath>
        </field>
    </record>
    <record id="action_resubscribe_selected_users" model="ir.actions.server">
        <field name="name">Resubscribe Selected</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
template_id = env.context.get('subscription_template_id')
template = env['mail.template'].browse(template_id).exists() if template_id else env['mail.template']
if template:
    opted_out_users = records.filtered(lambda user: template in user.unsubscribed_template_ids)
    opted_out_users.write({'unsubscribed_template_ids': [(3, template.id)]})
    action = {'type': 'ir.actions.client', 'tag': 'reload'}
        ]]></field>
    </record>

</odoo>
